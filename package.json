{
  "name": "lookr",
  "version": "0.0.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --project=chromium --headed --workers=1",
    "e2e:us1": "playwright test e2e/specs/dashboard-core.spec.ts",
    "e2e:us2": "playwright test e2e/specs/history-regression.spec.ts e2e/specs/progress-regression.spec.ts",
    "e2e:coverage": "node --experimental-strip-types e2e/support/validate-coverage-manifest.ts",
    "lint": "npm run format:check && npm run typecheck && npm run oxlint",
    "lint:fix": "oxlint . --type-aware --fix --ignore-path .gitignore --tsconfig tsconfig.json",
    "oxlint": "oxlint . --type-aware --deny-warnings --ignore-path .gitignore --tsconfig tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "tsc --noEmit",
    "build:android": "expo prebuild --platform android --no-install && ./android/gradlew -p android assembleRelease",
    "release:android:major": "sh scripts/release-android.sh major",
    "release:android:minor": "sh scripts/release-android.sh minor",
    "release:android:patch": "sh scripts/release-android.sh patch"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.12",
    "expo-constants": "~55.0.12",
    "expo-device": "~55.0.13",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.11",
    "expo-router": "~55.0.11",
    "expo-splash-screen": "~55.0.16",
    "expo-sqlite": "~55.0.14",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.14",
    "expo-web-browser": "~55.0.13",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^55.0.16",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  }
}
