{
  "expo": {
    "name": "lookr",
    "slug": "lookr",
    "version": "0.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/appicon.png",
    "scheme": "lookr",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "backgroundColor": "#F8FAFB",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "ios": {
      "icon": "./assets/appicon.png",
      "bundleIdentifier": "com.anonymous.lookr"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/appicon-android-foreground.png",
        "backgroundImage": "./assets/images/appicon-android-background.png",
        "monochromeImage": "./assets/images/appicon-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.lookr"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/appicon-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6EFE6",
          "android": {
            "image": "./assets/images/appicon-splash.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/appicon.png",
          "color": "#00D18E",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
